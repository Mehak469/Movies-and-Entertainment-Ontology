        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:range rdf:resource="http://schema.org/Review"/>
        <rdfs:comment>&quot;Relates a viewer to the review they have authored.&quot;</rdfs:comment>
        <rdfs:label>writesReview</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#writtenByViewer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#writtenByViewer">
        <rdfs:domain rdf:resource="http://schema.org/Review"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:comment>&quot;Relates a review to the viewer who wrote it.&quot;</rdfs:comment>
        <rdfs:label>writtenByViewer</rdfs:label>
    </owl:ObjectProperty>
    


