    <!-- http://schema.org/awards -->

    <owl:DatatypeProperty rdf:about="http://schema.org/awards">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Movie"/>
                    <rdf:Description rdf:about="http://snomed.info/id/308009001"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Actor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>&quot;A textual list of awards received 
                    by a media work or person.&quot;</rdfs:comment>
        <rdfs:label>awards</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/bestRating -->

    <owl:DatatypeProperty rdf:about="http://schema.org/bestRating">
        <rdfs:domain rdf:resource="http://schema.org/Rating"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>&quot;The maximum possible score in 
                    a rating scale.&quot;</rdfs:comment>
        <rdfs:label>bestRating</rdfs:label>
    </owl:DatatypeProperty>
    


