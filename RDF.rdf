        <rdfs:label>birthDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/dateCreated -->

    <owl:DatatypeProperty rdf:about="http://schema.org/dateCreated">
        <rdfs:domain rdf:resource="http://schema.org/Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>&quot;The date on which a review or 
