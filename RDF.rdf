            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Rater"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>&quot;The date on which the viewer or rater joined the platform.&quot;</rdfs:comment>
        <rdfs:label>memberSince</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#subscriptionPrice -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#subscriptionPrice">
