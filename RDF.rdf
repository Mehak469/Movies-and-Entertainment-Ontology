        <rdfs:label>hasLanguage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/actor -->

    <owl:ObjectProperty rdf:about="https://schema.org/actor">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Actor"/>
        <rdfs:comment>&quot;Relates a creative work to the actor who performs in it.&quot;</rdfs:comment>
        <rdfs:label>hasActor</rdfs:label>
    </owl:ObjectProperty>
    


