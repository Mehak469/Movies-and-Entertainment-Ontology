<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26/"
     xml:base="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26/"
     xmlns:ns="http://www.w3.org/2006/vcard/ns#"
     xmlns:CLO="http://purl.obolibrary.org/obo/clo/clo_merged.owl/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:GSSO="http://purl.obolibrary.org/obo/gsso.owl/"
     xmlns:LABO="http://purl.obolibrary.org/obo/labo.owl#"
     xmlns:MESH="https://w3id.org/biopragmatics/resources/mesh/mesh.ofn/"
     xmlns:NGBO="http://purl.obolibrary.org/obo/ngbo.owl#"
     xmlns:SLSO="http://purl.obolibrary.org/obo/slso.owl"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:EVORAO="https://w3id.org/evorao/evorao.owl.ttl/"
     xmlns:SNOMED="http://snomed.info/sct/9000000000002070081231/"
     xmlns:schema="https://schema.org/"
     xmlns:schema1="http://schema.org/"
     xmlns:untitled-ontology-26="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26">
        <rdfs:comment>This ontology models the movie and entertainment domain,
including media content, genres, cast and crew members,
ratings, reviews, awards, subtitles, languages,
production companies, countries, and online streaming platforms.
The ontology supports structured representation,
search, and recommendation of entertainment content.</rdfs:comment>
        <rdfs:label>Movie and Entertainment Management Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/RO_0003001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0003001">
        <owl:inverseOf rdf:resource="https://schema.org/produces"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment>&quot;Relates a creative work to the organization 
                    that produced it.&quot;</rdfs:comment>
        <rdfs:label>producedByCompany</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#actsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#actsIn">
        <owl:inverseOf rdf:resource="https://schema.org/actor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Actor"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates an actor to the creative work they perform in.&quot;</rdfs:comment>
        <rdfs:label>actsIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#availableOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#availableOn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hosts"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#OnlineRetailer"/>
        <rdfs:comment>&quot;Relates a media work to the platform where it can be accessed.&quot;</rdfs:comment>
        <rdfs:label>availableOn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#awardGivenTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#awardGivenTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#receivedAward"/>
        <rdfs:domain rdf:resource="http://id.nlm.nih.gov/mesh/D001363"/>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>&quot;Relates an award to the person who received it.&quot;</rdfs:comment>
        <rdfs:label>awardGivenTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#awardedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#awardedTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasAward"/>
        <rdfs:domain rdf:resource="http://id.nlm.nih.gov/mesh/D001363"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates an award to the creative work that received it.&quot;</rdfs:comment>
        <rdfs:label>awardedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#belongsToCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#belongsToCountry">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/Country"/>
        <rdfs:comment>&quot;Relates a creative work to its country of origin.&quot;</rdfs:comment>
        <rdfs:label>belongsToCountry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#direct -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#direct">
        <owl:inverseOf rdf:resource="https://schema.org/director"/>
        <rdfs:domain rdf:resource="http://snomed.info/id/308009001"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a director to the creative work they directed.&quot;</rdfs:comment>
        <rdfs:label>direct</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#distributedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#distributedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#distrubutes"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#OnlineRetailer"/>
        <rdfs:comment>&quot;Relates a media work to the retailer distributing it.&quot;</rdfs:comment>
        <rdfs:label>distributedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#distrubutes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#distrubutes">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#OnlineRetailer"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates an online retailer to the creative 
                    work it distributes to viewers.&quot;</rdfs:comment>
        <rdfs:label>distributes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#followedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#followedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#followsSeries"/>
        <rdfs:domain rdf:resource="http://schema.org/TVSeries"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:comment>&quot;Relates a TV series to the viewer who regularly follows it.&quot;</rdfs:comment>
        <rdfs:label>followedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#followsSeries -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#followsSeries">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:range rdf:resource="http://schema.org/TVSeries"/>
        <rdfs:comment>&quot;Relates a viewer to a TV series they regularly follow.&quot;</rdfs:comment>
        <rdfs:label>followsSeries</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#givenByRater -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#givenByRater">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#givesRating"/>
        <rdfs:domain rdf:resource="http://schema.org/Rating"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Rater"/>
        <rdfs:comment>&quot;Relates a rating to the rater who provided it.&quot;</rdfs:comment>
        <rdfs:label>givenByRater</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#givesRating -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#givesRating">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Rater"/>
        <rdfs:range rdf:resource="http://schema.org/Rating"/>
        <rdfs:comment>&quot;Relates a rater to the rating they assign.&quot;</rdfs:comment>
        <rdfs:label>givesRating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasAward -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasAward">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://id.nlm.nih.gov/mesh/D001363"/>
        <rdfs:comment>&quot;Relates a creative work to an award it has received.&quot;</rdfs:comment>
        <rdfs:label>hasAward</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasGenre">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isGenreOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://id.nlm.nih.gov/mesh/D001363"/>
                    <rdf:Description rdf:about="http://schema.org/CreativeWork"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#OnlineRetailer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Genre"/>
        <rdfs:comment>&quot;Relates a media work to its genre classification.&quot;</rdfs:comment>
        <rdfs:label>hasGenre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasRating -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasRating">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isRatingOf"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://schema.org/Rating"/>
        <rdfs:comment>&quot;Relates a creative work to its associated rating.&quot;</rdfs:comment>
        <rdfs:label>hasRating</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasReview -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasReview">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isReviewOf"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://schema.org/Review"/>
        <rdfs:comment>&quot;Relates a creative work to a review written about it.&quot;</rdfs:comment>
        <rdfs:label>hasReview</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasReviewer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasReviewer">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#reviewsMedia"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:comment>&quot;Relates a creative work to the viewer who reviewed it.&quot;</rdfs:comment>
        <rdfs:label>hasReviewer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasSubtitle -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasSubtitle">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#subtitleOf"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Subtitle"/>
        <rdfs:comment>&quot;Relates a media work to its subtitle resource.&quot;</rdfs:comment>
        <rdfs:label>hasSubtitle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasSubtitleLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hasSubtitleLanguage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Subtitle"/>
        <rdfs:range rdf:resource="http://schema.org/Language"/>
        <rdfs:comment>&quot;Relates a subtitle to the language it is written in.&quot;</rdfs:comment>
        <rdfs:label>hasSubtitleLanguage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hosts -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#hosts">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#OnlineRetailer"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates an online platform to the media content it hosts.&quot;</rdfs:comment>
        <rdfs:label>hosts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isGenreOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isGenreOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Genre"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a genre to the creative work it classifies.&quot;</rdfs:comment>
        <rdfs:label>isGenreOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isLikedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isLikedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#likesMedia"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:comment>&quot;Relates a media work to a viewer who expressed a like for it.&quot;</rdfs:comment>
        <rdfs:label>isLikedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isRatingOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isRatingOf">
        <rdfs:domain rdf:resource="http://schema.org/Rating"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a rating to the creative work it evaluates.&quot;</rdfs:comment>
        <rdfs:label>isRatingOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isReviewOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#isReviewOf">
        <rdfs:domain rdf:resource="http://schema.org/Review"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a review to the creative work it describes.&quot;</rdfs:comment>
        <rdfs:label>isReviewOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#likesMedia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#likesMedia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a viewer to the media content they have liked.&quot;</rdfs:comment>
        <rdfs:label>likesMedia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#ratedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#ratedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#ratesMedia"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Rater"/>
        <rdfs:comment>&quot;Relates a creative work to the rater who evaluated it.&quot;</rdfs:comment>
        <rdfs:label>ratedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#ratesMedia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#ratesMedia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Rater"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a rater to the media content they have rated.&quot;</rdfs:comment>
        <rdfs:label>ratesMedia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#receivedAward -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#receivedAward">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://id.nlm.nih.gov/mesh/D001363"/>
        <rdfs:comment>&quot;Relates a person to an award they have received.&quot;</rdfs:comment>
        <rdfs:label>receivedAward</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#reviewsMedia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#reviewsMedia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a viewer to the media content they have reviewed.&quot;</rdfs:comment>
        <rdfs:label>reviewsMedia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#subtitleOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#subtitleOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Subtitle"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a subtitle to the creative work it belongs to.&quot;</rdfs:comment>
        <rdfs:label>subtitleOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#watchedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#watchedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#watches"/>
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:comment>&quot;Relates a media work to the viewer who has watched it.&quot;</rdfs:comment>
        <rdfs:label>watchedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#watches -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#watches">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Viewer"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment>&quot;Relates a viewer to the media content they have watched.&quot;</rdfs:comment>
        <rdfs:label>watches</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#writesReview -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#writesReview">
