        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://snomed.info/id/308004006"/>
                    <rdf:Description rdf:about="http://snomed.info/id/308009001"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ladla&apos;s_elliz/ontologies/2026/3/untitled-ontology-26#Actor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>&quot;The date of birth of a person associated 
