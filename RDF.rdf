    <!-- https://schema.org/director -->

    <owl:ObjectProperty rdf:about="https://schema.org/director">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://snomed.info/id/308009001"/>
        <rdfs:comment>&quot;Relates a creative work to its director.&quot;</rdfs:comment>
